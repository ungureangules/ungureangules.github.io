---
import SectionHeading from './SectionHeading.astro';

const quote =
	'Everything that is boring and repetitive should be automated. What is fun and repetitive should not.';
const words = quote.split(' ');

const traits = [
	{
		flag: '--fix-broken-things',
		title: 'Driven by challenges',
		body: 'I go looking for the systems everyone else gave up on. Broken pipelines, undocumented legacy, "we just do it manually" processes — that is the fun part. Especially when someone already failed at it.',
	},
	{
		flag: '--bridge-legacy-ai',
		title: 'Translator, not just a coder',
		body: 'Eleven years sitting between infrastructure, developers and the people who actually use the thing. I speak all three, so AI stops being a demo and starts being a workflow that survives Monday morning.',
	},
	{
		flag: '--no-mindless-repetition',
		title: 'Allergic to busywork',
		body: 'If a human does it twice the same way, it should be a script, a service or an agent. I would rather spend a day building the automation than a year performing the task.',
	},
];
---

<section id="about" class="relative px-5 py-20 md:px-8 md:py-24">
	<div class="mx-auto max-w-6xl">
		<SectionHeading index="01" title="philosophy" command="cat ~/.philosophy" />

		<!-- ── pull quote, revealed word by word ─────────────── -->
		<blockquote class="mb-16 max-w-4xl md:mb-20">
			<p
				class="text-balance font-sans text-2xl leading-snug tracking-tight text-white sm:text-3xl md:text-[2.6rem] md:leading-[1.15]"
			>
				{
					words.map((w, i) => (
						<span class="reveal inline-block" style={`--i:${(i * 0.45).toFixed(2)}`}>
							{w}&nbsp;
						</span>
					))
				}
			</p>
			<footer class="reveal mt-6 flex items-center gap-3 text-xs text-dim" style="--i:2">
				<span class="h-px w-8 bg-arch"></span>
				operating principle #1
			</footer>
		</blockquote>

		<!-- ── traits as --help output ───────────────────────── -->
		<div class="grid gap-px border border-line bg-line md:grid-cols-3">
			{
				traits.map((t, i) => (
					<article
						class="reveal sheen group relative bg-ink p-6 transition-colors duration-500 hover:bg-surface md:p-8"
						style={`--i:${i}`}
					>
						<span class="absolute right-5 top-5 text-[0.625rem] text-line-2 transition-colors duration-300 group-hover:text-arch">
							0{i + 1}
						</span>
						<code class="text-[0.6875rem] text-lime">{t.flag}</code>
						<h3 class="mt-3 text-lg font-bold text-white transition-colors duration-300 group-hover:text-arch-2">
							{t.title}
						</h3>
						<p class="mt-3 font-sans text-sm leading-relaxed text-dim">{t.body}</p>
						<span class="mt-6 block h-px w-0 bg-arch transition-all duration-500 group-hover:w-full"></span>
					</article>
				))
			}
		</div>
	</div>
</section>
