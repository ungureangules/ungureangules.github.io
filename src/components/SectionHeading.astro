---
interface Props {
	index: string;
	title: string;
	command: string;
	accent?: 'arch' | 'lime';
}

const { index, title, command, accent = 'arch' } = Astro.props;
const accentClass = accent === 'lime' ? 'text-lime' : 'text-arch';
---

<div class="reveal mb-12 md:mb-16" style="--i:0">
	<div class="mb-4 flex items-center gap-4">
		<span class={`text-xs ${accentClass}`}>{index}</span>
		<span class="h-px flex-1 bg-line"></span>
		<span class="section-label">{title}</span>
	</div>
	<p class="flex items-baseline gap-2 text-sm md:text-base">
		<span class={accentClass}>$</span>
		<span class="text-fg">{command}</span>
	</p>
</div>
