---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-zinc-950 text-zinc-300 selection:bg-orange-500/30">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Italo Gules - Serial Fixer & AI Automation Specialist" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
	</head>
	<body class="min-h-screen font-sans antialiased">
		<div class="fixed inset-0 -z-10 h-full w-full bg-zinc-950">
			<div class="absolute bottom-0 left-0 right-0 top-0 bg-[linear-gradient(to_right,#27272a_1px,transparent_1px),linear-gradient(to_bottom,#27272a_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
		</div>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Inter', system-ui, sans-serif;
		--font-mono: 'JetBrains Mono', monospace;
	}
	
	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: var(--font-sans);
	}

	code {
		font-family: var(--font-mono);
	}
</style>
