---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-zinc-950 text-zinc-300 selection:bg-[#1793d1]/30">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Italo Gules - AI Automation Specialist" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
	</head>
	<body class="min-h-screen font-sans antialiased">
		<div class="fixed inset-0 -z-10 h-full w-full bg-zinc-950">
			<canvas id="bg-canvas" class="absolute inset-0 w-full h-full opacity-20"></canvas>
		</div>
		<slot />

		<script>
			// Background canvas: floating Python snippets + Arch logos
			const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement;
			const ctx = canvas.getContext('2d')!;
			canvas.width = window.innerWidth;
			canvas.height = window.innerHeight;
			window.addEventListener('resize', () => { canvas.width = window.innerWidth; canvas.height = window.innerHeight; });

			const ARCH_BLUE = '#1793d1';
			const snippets = [
				'def automate(task):',
				'  return task.run()',
				'import subprocess',
				'agent.invoke(prompt)',
				'for proc in processes:',
				'  if proc.boring:',
				'    automate(proc)',
				'llm = Hermes()',
				'os.system(cmd)',
				'async def fix():',
				'claude.run_agent()',
				'subprocess.Popen()',
				'@dataclass',
				'yield result',
			];

			type Particle = { x: number; y: number; speed: number; text: string; size: number; alpha: number; isArch: boolean; };
			const particles: Particle[] = Array.from({ length: 28 }, () => ({
				x: Math.random() * canvas.width,
				y: Math.random() * canvas.height,
				speed: 0.2 + Math.random() * 0.4,
				text: snippets[Math.floor(Math.random() * snippets.length)],
				size: 11 + Math.random() * 6,
				alpha: 0.15 + Math.random() * 0.35,
				isArch: Math.random() < 0.15,
			}));

			function drawArch(x: number, y: number, size: number, alpha: number) {
				ctx.save();
				ctx.globalAlpha = alpha;
				ctx.fillStyle = ARCH_BLUE;
				const scale = size / 182;
				ctx.translate(x, y);
				ctx.scale(scale, scale);
				const p = new Path2D('M 105.8125 16.625 c -7.39687 18.135158 -11.858304 29.997682 -20.09375 47.59375 5.04936 5.35232 11.247211 11.585364 21.3125 18.625 C 96.210077 78.390904 88.828713 73.920352 83.3125 69.28125 72.7727 91.274163 56.259864 122.60209 22.75 182.8125 c 26.337628 -15.205170 46.754089 -24.579320 65.78125 -28.15625 -0.817034 -3.514100 -1.281534 -7.315230 -1.25 -11.28125 l 0.03125 -0.84375 c 0.417917 -16.87382 9.195665 -29.84979 19.59375 -28.96875 10.39809 0.88104 18.48041 15.28242 18.0625 32.15625 -0.0786 3.17512 -0.43674 6.22955 -1.0625 9.0625 18.82058 3.68164 39.01873 13.03179 65 28.03125 -5.123 -9.4318 -9.69572 -17.93388 -14.0625 -26.03125 -6.87839 -5.33121 -14.05289 -12.2698 -28.6875 -19.78125 10.05899 2.61375 17.2611 5.62932 22.875 9 C 124.63297 63.338161 121.03766 52.354109 105.8125 16.625 z');
				ctx.fill(p);
				ctx.restore();
			}

			function animate() {
				ctx.clearRect(0, 0, canvas.width, canvas.height);
				for (const p of particles) {
					p.y -= p.speed;
					if (p.y < -40) { p.y = canvas.height + 20; p.x = Math.random() * canvas.width; }
					if (p.isArch) {
						drawArch(p.x, p.y, p.size * 2.5, p.alpha);
					} else {
						ctx.globalAlpha = p.alpha;
						ctx.fillStyle = ARCH_BLUE;
						ctx.font = `${p.size}px 'JetBrains Mono', monospace`;
						ctx.fillText(p.text, p.x, p.y);
					}
				}
				ctx.globalAlpha = 1;
				requestAnimationFrame(animate);
			}
			animate();

			// Scroll-triggered fade-in for sections
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(e => {
					if (e.isIntersecting) {
						(e.target as HTMLElement).style.opacity = '1';
						(e.target as HTMLElement).style.transform = 'translateY(0)';
						observer.unobserve(e.target);
					}
				});
			}, { threshold: 0.1 });

			document.querySelectorAll('section').forEach(s => {
				s.style.opacity = '0';
				s.style.transform = 'translateY(40px)';
				s.style.transition = 'opacity 0.7s ease, transform 0.7s ease';
				observer.observe(s);
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Inter', system-ui, sans-serif;
		--font-mono: 'JetBrains Mono', monospace;
	}
	
	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: var(--font-sans);
	}

	code {
		font-family: var(--font-mono);
	}
</style>
