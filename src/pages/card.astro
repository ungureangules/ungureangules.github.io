---
import Layout from '../layouts/Layout.astro';
import QRCode from 'qrcode';

const cardUrl = 'https://italogules.dev/card';
const qrDataUrl = await QRCode.toDataURL(cardUrl, {
	width: 320,
	margin: 1,
	color: { dark: '#56b6e8', light: '#07080a' },
});

const rows = [
	{
		key: 'tel',
		value: '0485 694 010',
		href: 'tel:+61485694010',
		icon: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.6a2 2 0 0 1-.5 2.1L8.1 9.6a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.6 2.6.7a2 2 0 0 1 1.7 2Z',
	},
	{
		key: 'mail',
		value: 'dev@italogules.dev',
		href: 'mailto:dev@italogules.dev',
		icon: 'M3 8l7.9 5.3a2 2 0 0 0 2.2 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z',
	},
	{
		key: 'www',
		value: 'italogules.dev',
		href: 'https://italogules.dev',
		icon: 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0zM3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z',
	},
	{
		key: 'in',
		value: 'in/italogules',
		href: 'https://www.linkedin.com/in/italogules/',
		icon: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-13h4v1.5A6 6 0 0 1 16 8zM2 9h4v12H2zM4 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4z',
	},
];
---

<Layout
	title="Italo Gules — Contact Card"
	description="Contact card for Italo Gules, AI Automation Specialist on the Gold Coast."
	backdrop="quiet"
>
	<main class="flex min-h-svh items-center justify-center px-4 py-12">
		<div class="w-full max-w-sm">
			<div class="term boot-in overflow-hidden">
				<div class="term-bar">
					<span class="term-dots"><i></i><i></i><i></i></span>
					<span class="ml-1">cat italo.vcf</span>
					<span class="ml-auto text-[0.625rem]" id="card-clock">--:--</span>
				</div>

				<!-- identity -->
				<div class="relative border-b border-line p-6">
					<div class="flex items-center gap-4">
						<div class="relative shrink-0 border border-line-2 p-1">
							<img
								src="/FotoPerfil.jpg"
								alt="Italo Gules"
								width="80"
								height="80"
								class="h-20 w-20 object-cover transition-transform duration-700 hover:scale-[1.06]"
							/>
							<span
								class="pointer-events-none absolute inset-1 bg-[repeating-linear-gradient(to_bottom,rgba(23,147,209,0.14)_0_1px,transparent_1px_3px)]"
							></span>
						</div>
						<div class="min-w-0">
							<h1 class="display text-[1.75rem] leading-none text-white">
								<span class="glitch" data-glitch data-text="ITALO">ITALO</span><br />
								<span class="glitch text-arch" data-glitch data-text="GULES">GULES</span>
							</h1>
							<p class="mt-2 flex items-center gap-2 text-[0.6875rem] text-dim">
								<span class="dot-live"></span>
								AI Automation Specialist
							</p>
						</div>
					</div>
					<p class="mt-4 text-[0.625rem] text-dim">
						11y IT · Gold Coast, QLD · automating the boring parts
					</p>
				</div>

				<!-- contact rows -->
				<dl>
					{
						rows.map((r, i) => (
							<a
								href={r.href}
								target={r.href.startsWith('http') ? '_blank' : undefined}
								rel={r.href.startsWith('http') ? 'noopener' : undefined}
								class={`group flex items-center gap-3 px-5 py-3 transition-colors duration-300 hover:bg-surface ${
									i > 0 ? 'border-t border-line' : ''
								}`}
							>
								<svg
									class="h-4 w-4 shrink-0 text-line-2 transition-colors duration-300 group-hover:text-arch"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.75"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d={r.icon} />
								</svg>
								<dt class="w-10 shrink-0 text-[0.625rem] uppercase tracking-[0.15em] text-line-2">
									{r.key}
								</dt>
								<dd class="min-w-0 truncate text-xs text-fg transition-colors duration-300 group-hover:text-arch-2">
									{r.value}
								</dd>
								<span class="ml-auto shrink-0 text-line-2 transition-all duration-300 group-hover:translate-x-1 group-hover:text-arch">
									→
								</span>
							</a>
						))
					}
				</dl>

				<!-- QR -->
				<div class="flex flex-col items-center gap-3 border-t border-line px-6 py-6">
					<p class="text-[0.625rem] uppercase tracking-[0.2em] text-dim">scan to save</p>
					<div class="border border-line p-2">
						<img src={qrDataUrl} alt="QR code for this card" width="128" height="128" class="h-32 w-32" />
					</div>
				</div>

				<!-- actions -->
				<div class="grid grid-cols-3 gap-px border-t border-line bg-line">
					<a href="/italo.vcf" class="sheen group flex flex-col items-center gap-2 bg-ink px-2 py-4 transition-colors duration-300 hover:bg-surface">
						<svg class="h-4 w-4 text-arch" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
							<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
							<circle cx="9" cy="7" r="4" />
							<path d="M19 8v6M22 11h-6" />
						</svg>
						<span class="text-[0.625rem] text-dim transition-colors group-hover:text-fg">add contact</span>
					</a>
					<button id="save-qr" class="sheen group flex cursor-pointer flex-col items-center gap-2 bg-ink px-2 py-4 transition-colors duration-300 hover:bg-surface">
						<svg class="h-4 w-4 text-arch" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
						</svg>
						<span class="text-[0.625rem] text-dim transition-colors group-hover:text-fg">save qr</span>
					</button>
					<button id="share-card" class="sheen group flex cursor-pointer flex-col items-center gap-2 bg-ink px-2 py-4 transition-colors duration-300 hover:bg-surface">
						<svg class="h-4 w-4 text-arch" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="18" cy="5" r="3" />
							<circle cx="6" cy="12" r="3" />
							<circle cx="18" cy="19" r="3" />
							<path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" />
						</svg>
						<span id="share-label" class="text-[0.625rem] text-dim transition-colors group-hover:text-fg">share</span>
					</button>
				</div>
			</div>

			<div class="mt-5 flex items-center justify-between text-[0.625rem] text-line-2">
				<a href="/" class="link">← cd ~</a>
				<span>italogules.dev</span>
			</div>
		</div>
	</main>

	<script define:vars={{ qrDataUrl, cardUrl }}>
		document.getElementById('save-qr')?.addEventListener('click', () => {
			const a = document.createElement('a');
			a.href = qrDataUrl;
			a.download = 'italo-gules-qr.png';
			a.click();
		});

		const shareBtn = document.getElementById('share-card');
		const shareLabel = document.getElementById('share-label');
		shareBtn?.addEventListener('click', async () => {
			const flash = (msg) => {
				if (!shareLabel) return;
				shareLabel.textContent = msg;
				setTimeout(() => (shareLabel.textContent = 'share'), 1600);
			};
			try {
				if (navigator.share) {
					await navigator.share({ title: 'Italo Gules', url: cardUrl });
				} else {
					await navigator.clipboard.writeText(cardUrl);
					flash('copied');
				}
			} catch {
				/* user dismissed the share sheet — nothing to do */
			}
		});

		const cardClock = document.getElementById('card-clock');
		if (cardClock) {
			const fmt = new Intl.DateTimeFormat('en-AU', {
				timeZone: 'Australia/Brisbane',
				hour: '2-digit',
				minute: '2-digit',
				hour12: false,
			});
			const tick = () => (cardClock.textContent = `${fmt.format(new Date())} AEST`);
			tick();
			setInterval(tick, 20000);
		}

		if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
			const targets = Array.from(document.querySelectorAll('[data-glitch]'));
			setInterval(() => {
				const el = targets[(Math.random() * targets.length) | 0];
				if (!el) return;
				el.classList.add('is-glitching');
				setTimeout(() => el.classList.remove('is-glitching'), 340);
			}, 4800);
		}
	</script>
</Layout>
