---
import Layout from '../layouts/Layout.astro';
import QRCode from 'qrcode';

const cardUrl = 'https://italogules.dev/card';
const qrDataUrl = await QRCode.toDataURL(cardUrl, {
	width: 200,
	margin: 2,
	color: { dark: '#1793d1', light: '#09090b' }
});
---

<Layout title="Italo Gules | Contact Card">
	<main class="min-h-screen flex items-center justify-center px-4 py-16">
		<div class="w-full max-w-sm">
			<!-- Card -->
			<div class="rounded-2xl border border-zinc-800 bg-zinc-900/80 backdrop-blur overflow-hidden shadow-2xl shadow-black/50">

				<!-- Header stripe -->
				<div class="h-2 bg-gradient-to-r from-[#1793d1] to-[#56b6e8]"></div>

				<!-- Photo + name -->
				<div class="flex flex-col items-center pt-8 pb-6 px-6">
					<div class="w-28 h-28 rounded-full overflow-hidden border-2 border-[#1793d1] mb-4 shadow-lg shadow-[#1793d1]/20">
						<img src="/FotoPerfil.jpg" alt="Italo Gules" class="w-full h-full object-cover" />
					</div>
					<h1 class="text-2xl font-bold text-white">Italo Gules</h1>
					<p class="text-sm text-[#1793d1] mt-1 text-center">AI Automation Specialist</p>
				</div>

				<!-- Contact info -->
				<div class="px-6 pb-6 space-y-3">
					<a href="tel:0485694010" class="flex items-center gap-3 text-zinc-400 hover:text-white transition-colors group">
						<span class="w-8 h-8 rounded-lg bg-zinc-800 group-hover:bg-[#1793d1]/20 flex items-center justify-center transition-colors">
							<svg class="w-4 h-4 text-[#1793d1]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
						</span>
						<span class="text-sm font-mono">0485 694 010</span>
					</a>
					<a href="mailto:dev@italogules.dev" class="flex items-center gap-3 text-zinc-400 hover:text-white transition-colors group">
						<span class="w-8 h-8 rounded-lg bg-zinc-800 group-hover:bg-[#1793d1]/20 flex items-center justify-center transition-colors">
							<svg class="w-4 h-4 text-[#1793d1]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
						</span>
						<span class="text-sm">dev@italogules.dev</span>
					</a>
					<a href="https://italogules.dev" target="_blank" class="flex items-center gap-3 text-zinc-400 hover:text-white transition-colors group">
						<span class="w-8 h-8 rounded-lg bg-zinc-800 group-hover:bg-[#1793d1]/20 flex items-center justify-center transition-colors">
							<svg class="w-4 h-4 text-[#1793d1]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
						</span>
						<span class="text-sm">italogules.dev</span>
					</a>
					<a href="https://www.linkedin.com/in/italogules/" target="_blank" class="flex items-center gap-3 text-zinc-400 hover:text-white transition-colors group">
						<span class="w-8 h-8 rounded-lg bg-zinc-800 group-hover:bg-[#1793d1]/20 flex items-center justify-center transition-colors">
							<svg class="w-4 h-4 text-[#1793d1]" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
						</span>
						<span class="text-sm">linkedin.com/in/italogules</span>
					</a>
				</div>

				<!-- Divider -->
				<div class="mx-6 border-t border-zinc-800"></div>

				<!-- QR Code -->
				<div class="flex flex-col items-center py-6 px-6">
					<p class="text-xs text-zinc-500 mb-3 uppercase tracking-widest font-mono">Scan to open card</p>
					<div class="rounded-xl overflow-hidden border border-zinc-800 p-2 bg-zinc-950">
						<img src={qrDataUrl} alt="QR Code" class="w-36 h-36" />
					</div>
				</div>

				<!-- Divider -->
				<div class="mx-6 border-t border-zinc-800"></div>

				<!-- Action buttons -->
				<div class="p-6 grid grid-cols-3 gap-3">
					<a
						href="/italo.vcf"
						class="flex flex-col items-center gap-2 p-3 rounded-xl bg-zinc-800 hover:bg-[#1793d1]/20 border border-zinc-700 hover:border-[#1793d1]/40 transition-all group"
					>
						<svg class="w-5 h-5 text-[#1793d1]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
						<span class="text-[10px] text-zinc-400 group-hover:text-white transition-colors text-center leading-tight">Add Contact</span>
					</a>
					<button
						id="save-qr"
						class="flex flex-col items-center gap-2 p-3 rounded-xl bg-zinc-800 hover:bg-[#1793d1]/20 border border-zinc-700 hover:border-[#1793d1]/40 transition-all group cursor-pointer"
					>
						<svg class="w-5 h-5 text-[#1793d1]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
						<span class="text-[10px] text-zinc-400 group-hover:text-white transition-colors text-center leading-tight">Save QR</span>
					</button>
					<a
						href="mailto:dev@italogules.dev"
						class="flex flex-col items-center gap-2 p-3 rounded-xl bg-zinc-800 hover:bg-[#1793d1]/20 border border-zinc-700 hover:border-[#1793d1]/40 transition-all group"
					>
						<svg class="w-5 h-5 text-[#1793d1]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
						<span class="text-[10px] text-zinc-400 group-hover:text-white transition-colors text-center leading-tight">Email Me</span>
					</a>
				</div>

			</div>

			<!-- Footer -->
			<p class="text-center text-zinc-600 text-xs mt-6 font-mono">italogules.dev</p>
			<div class="flex justify-center mt-4">
				<a href="/" class="flex items-center gap-2 px-4 py-2 rounded-lg bg-zinc-900 border border-zinc-800 hover:border-[#1793d1]/40 text-zinc-400 hover:text-white text-sm transition-all">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
					Close
				</a>
			</div>
		</div>
	</main>

	<script define:vars={{ qrDataUrl }}>
		document.getElementById('save-qr')?.addEventListener('click', () => {
			const a = document.createElement('a');
			a.href = qrDataUrl;
			a.download = 'italo-gules-qr.png';
			a.click();
		});
	</script>
</Layout>
