---
import Layout from '../layouts/Layout.astro';
import QRCode from 'qrcode';

const cardUrl = 'https://italogules.dev/lorena';
const qrDataUrl = await QRCode.toDataURL(cardUrl, {
	width: 200,
	margin: 2,
	color: { dark: '#a855f7', light: '#09090b' }
});
---

<Layout title="Lorena Miquett | Contact Card">
	<main class="min-h-screen flex items-center justify-center px-4 py-16">
		<div class="w-full max-w-sm">
			<!-- Card -->
			<div class="rounded-2xl border border-zinc-800 bg-zinc-900/80 backdrop-blur overflow-hidden shadow-2xl shadow-black/50">

				<!-- Header stripe -->
				<div class="h-2 bg-gradient-to-r from-purple-500 to-pink-500"></div>

				<!-- Photo + name -->
				<div class="flex flex-col items-center pt-8 pb-6 px-6">
					<div class="w-28 h-28 rounded-full overflow-hidden border-2 border-purple-500 mb-4 shadow-lg shadow-purple-500/20">
						<img src="/retratolorena.jpg" alt="Lorena Miquett" class="w-full h-full object-cover" />
					</div>
					<h1 class="text-2xl font-bold text-white">Lorena Miquett</h1>
				</div>

				<!-- Contact info -->
				<div class="px-6 pb-6 space-y-3">
					<a href="tel:0411018971" class="flex items-center gap-3 text-zinc-400 hover:text-white transition-colors group">
						<span class="w-8 h-8 rounded-lg bg-zinc-800 group-hover:bg-purple-500/20 flex items-center justify-center transition-colors">
							<svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
						</span>
						<span class="text-sm font-mono">0411 018 971</span>
					</a>
					<a href="mailto:lorenamiquett@gmail.com" class="flex items-center gap-3 text-zinc-400 hover:text-white transition-colors group">
						<span class="w-8 h-8 rounded-lg bg-zinc-800 group-hover:bg-purple-500/20 flex items-center justify-center transition-colors">
							<svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
						</span>
						<span class="text-sm font-mono">lorenamiquett@gmail.com</span>
					</a>
				</div>

				<!-- Divider -->
				<div class="mx-6 border-t border-zinc-800"></div>

				<!-- QR Code -->
				<div class="flex flex-col items-center py-6 px-6">
					<p class="text-xs text-zinc-500 mb-3 uppercase tracking-widest font-mono">Scan to open card</p>
					<div class="rounded-xl overflow-hidden border border-zinc-800 p-2 bg-zinc-950">
						<img src={qrDataUrl} alt="QR Code" class="w-36 h-36" />
					</div>
				</div>

				<!-- Divider -->
				<div class="mx-6 border-t border-zinc-800"></div>

				<!-- Action buttons -->
				<div class="p-6 grid grid-cols-3 gap-3">
					<a
						href="/lorena.vcf"
						class="flex flex-col items-center gap-2 p-3 rounded-xl bg-zinc-800 hover:bg-purple-500/20 border border-zinc-700 hover:border-purple-500/40 transition-all group"
					>
						<svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
						<span class="text-[10px] text-zinc-400 group-hover:text-white transition-colors text-center leading-tight">Add Contact</span>
					</a>
					<button
						id="save-qr"
						class="flex flex-col items-center gap-2 p-3 rounded-xl bg-zinc-800 hover:bg-purple-500/20 border border-zinc-700 hover:border-purple-500/40 transition-all group cursor-pointer"
					>
						<svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
						<span class="text-[10px] text-zinc-400 group-hover:text-white transition-colors text-center leading-tight">Save QR</span>
					</button>
					<a
						href="mailto:lorenamiquett@gmail.com"
						class="flex flex-col items-center gap-2 p-3 rounded-xl bg-zinc-800 hover:bg-purple-500/20 border border-zinc-700 hover:border-purple-500/40 transition-all group"
					>
						<svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
						<span class="text-[10px] text-zinc-400 group-hover:text-white transition-colors text-center leading-tight">Email Me</span>
					</a>
				</div>

			</div>

			<!-- Footer -->
			<p class="text-center text-zinc-600 text-xs mt-6 font-mono">italogules.dev</p>
			<div class="flex justify-center mt-4">
				<a href="/" class="flex items-center gap-2 px-4 py-2 rounded-lg bg-zinc-900 border border-zinc-800 hover:border-purple-500/40 text-zinc-400 hover:text-white text-sm transition-all">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
					Close
				</a>
			</div>
		</div>
	</main>

	<script define:vars={{ qrDataUrl }}>
		document.getElementById('save-qr')?.addEventListener('click', () => {
			const a = document.createElement('a');
			a.href = qrDataUrl;
			a.download = 'lorena-miquett-qr.png';
			a.click();
		});
	</script>
</Layout>

<style>
	/* Hide the tech-specific background canvas for a clean, elegant look */
	:global(#bg-canvas) {
		display: none !important;
	}
</style>
