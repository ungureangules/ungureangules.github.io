---
import Layout from '../layouts/Layout.astro';
import QRCode from 'qrcode';

const cardUrl = 'https://italogules.dev/lorena';
const qrDataUrl = await QRCode.toDataURL(cardUrl, {
	width: 320,
	margin: 1,
	color: { dark: '#c084fc', light: '#0b0710' },
});

const rows = [
	{
		label: 'Phone',
		value: '0411 018 971',
		href: 'tel:+61411018971',
		icon: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.6a2 2 0 0 1-.5 2.1L8.1 9.6a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.6 2.6.7a2 2 0 0 1 1.7 2Z',
	},
	{
		label: 'Email',
		value: 'lorenamiquett@gmail.com',
		href: 'mailto:lorenamiquett@gmail.com',
		icon: 'M3 8l7.9 5.3a2 2 0 0 0 2.2 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z',
	},
];
---

<Layout
	title="Lorena Miquett — Contact Card"
	description="Contact card for Lorena Miquett."
	backdrop="quiet"
>
	<main class="lorena flex min-h-svh items-center justify-center px-4 py-12 font-sans">
		<div class="aura pointer-events-none fixed inset-0 -z-[5]" aria-hidden="true"></div>

		<div class="w-full max-w-sm">
			<div class="frame rise">
				<div class="card rounded-[1.75rem]">
					<!-- portrait -->
					<div class="flex flex-col items-center px-8 pt-10">
						<div class="halo relative mb-5">
							<img
								src="/retratolorena.jpg"
								alt="Lorena Miquett"
								width="120"
								height="120"
								class="relative z-10 h-28 w-28 rounded-full object-cover ring-1 ring-white/20"
							/>
						</div>
						<h1 class="text-2xl font-semibold tracking-tight text-white">Lorena Miquett</h1>
						<div
							class="mt-3 h-px w-14 bg-gradient-to-r from-transparent via-purple-300/60 to-transparent"
						>
						</div>
					</div>

					<!-- contact -->
					<div class="mt-8 space-y-2.5 px-6">
						{
							rows.map((r, i) => (
								<a
									href={r.href}
									class="row group flex items-center gap-4 rounded-2xl px-4 py-3.5"
									style={`--d:${120 + i * 90}ms`}
								>
									<span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white/5 ring-1 ring-white/10 transition-all duration-500 group-hover:bg-purple-500/20 group-hover:ring-purple-400/40">
										<svg
											class="h-4 w-4 text-purple-300"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d={r.icon} />
										</svg>
									</span>
									<span class="min-w-0">
										<span class="block text-[0.625rem] uppercase tracking-[0.18em] text-white/35">
											{r.label}
										</span>
										<span class="block truncate text-sm text-white/85 transition-colors duration-300 group-hover:text-white">
											{r.value}
										</span>
									</span>
									<span class="ml-auto text-white/25 transition-all duration-500 group-hover:translate-x-1 group-hover:text-purple-300">
										→
									</span>
								</a>
							))
						}
					</div>

					<!-- QR -->
					<div class="mt-8 flex flex-col items-center gap-3 px-8">
						<div class="h-px w-16 bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>
						<p class="text-[0.625rem] uppercase tracking-[0.24em] text-white/35">scan to save</p>
						<div class="rounded-2xl bg-white/[0.04] p-3 ring-1 ring-white/10">
							<img
								src={qrDataUrl}
								alt="QR code for this card"
								width="124"
								height="124"
								class="h-28 w-28 rounded-lg"
							/>
						</div>
					</div>

					<!-- actions -->
					<div class="mt-8 grid grid-cols-3 gap-2 px-6 pb-8">
						<a href="/lorena.vcf" class="act group">
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
								<circle cx="9" cy="7" r="4" />
								<path d="M19 8v6M22 11h-6" />
							</svg>
							<span>Save</span>
						</a>
						<button id="save-qr" class="act group cursor-pointer">
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
							</svg>
							<span>QR</span>
						</button>
						<a href="mailto:lorenamiquett@gmail.com" class="act group">
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M3 8l7.9 5.3a2 2 0 0 0 2.2 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z" />
							</svg>
							<span>Email</span>
						</a>
					</div>
				</div>
			</div>

			<p class="mt-6 text-center text-[0.625rem] uppercase tracking-[0.24em] text-white/25">
				italogules.dev
			</p>
		</div>
	</main>

	<script define:vars={{ qrDataUrl }}>
		document.getElementById('save-qr')?.addEventListener('click', () => {
			const a = document.createElement('a');
			a.href = qrDataUrl;
			a.download = 'lorena-miquett-qr.png';
			a.click();
		});
	</script>
</Layout>

<style>
	/* Lorena's card keeps its own soft, elegant identity — no terminal chrome. */
	.lorena {
		--plum: #c084fc;
		--rose: #f0abfc;
	}

	.aura {
		background:
			radial-gradient(38rem 28rem at 22% 12%, rgba(168, 85, 247, 0.22), transparent 65%),
			radial-gradient(32rem 26rem at 82% 78%, rgba(244, 114, 182, 0.18), transparent 65%),
			radial-gradient(26rem 22rem at 55% 50%, rgba(99, 102, 241, 0.12), transparent 70%);
		animation: aura-drift 18s ease-in-out infinite alternate;
	}

	@keyframes aura-drift {
		from { transform: translate3d(-1.5%, -1%, 0) scale(1); }
		to { transform: translate3d(2%, 2%, 0) scale(1.06); }
	}

	/* animated gradient hairline around the card */
	.frame {
		position: relative;
		padding: 1px;
		border-radius: 1.85rem;
		background: conic-gradient(
			from var(--angle, 0deg),
			rgba(255, 255, 255, 0.06),
			var(--plum),
			rgba(255, 255, 255, 0.06),
			var(--rose),
			rgba(255, 255, 255, 0.06)
		);
		animation: frame-spin 9s linear infinite;
		box-shadow: 0 40px 90px -40px rgba(168, 85, 247, 0.45);
	}

	@property --angle {
		syntax: '<angle>';
		initial-value: 0deg;
		inherits: false;
	}

	@keyframes frame-spin {
		to { --angle: 360deg; }
	}

	.card {
		background: linear-gradient(180deg, rgba(24, 16, 33, 0.94), rgba(11, 7, 16, 0.97));
		backdrop-filter: blur(14px);
	}

	.rise {
		animation: rise-in 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	@keyframes rise-in {
		from { opacity: 0; transform: translateY(26px) scale(0.97); }
		to { opacity: 1; transform: none; }
	}

	/* portrait halo */
	.halo::before {
		content: '';
		position: absolute;
		inset: -10px;
		border-radius: 999px;
		background: conic-gradient(from 0deg, var(--plum), var(--rose), var(--plum));
		filter: blur(14px);
		opacity: 0.55;
		animation: halo-spin 12s linear infinite;
	}

	@keyframes halo-spin {
		to { transform: rotate(360deg); }
	}

	.row {
		background: rgba(255, 255, 255, 0.03);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
		transition: background 0.45s ease, box-shadow 0.45s ease, transform 0.45s ease;
		animation: row-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: var(--d, 0ms);
	}
	.row:hover {
		background: rgba(192, 132, 252, 0.09);
		box-shadow: inset 0 0 0 1px rgba(192, 132, 252, 0.28);
		transform: translateY(-2px);
	}

	@keyframes row-in {
		from { opacity: 0; transform: translateY(12px); }
		to { opacity: 1; transform: none; }
	}

	.act {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.45rem;
		padding: 0.85rem 0.4rem;
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.04);
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
		color: rgba(255, 255, 255, 0.65);
		font-size: 0.6875rem;
		transition: background 0.4s ease, color 0.4s ease, box-shadow 0.4s ease,
			transform 0.4s ease;
	}
	.act svg {
		color: var(--plum);
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.act:hover {
		background: rgba(192, 132, 252, 0.14);
		box-shadow: inset 0 0 0 1px rgba(192, 132, 252, 0.35);
		color: #fff;
		transform: translateY(-3px);
	}
	.act:hover svg {
		transform: scale(1.12) translateY(-1px);
	}

	@media (prefers-reduced-motion: reduce) {
		.aura,
		.frame,
		.halo::before {
			animation: none;
		}
	}
</style>
