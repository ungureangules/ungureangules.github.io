---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import Ticker from '../components/Ticker.astro';
import QRCode from 'qrcode';

const qrDataUrl = await QRCode.toDataURL('https://italogules.dev/card', {
	width: 280,
	margin: 1,
	color: { dark: '#56b6e8', light: '#07080a' },
});

const tickerItems = [
	'Python',
	'Java',
	'React',
	'SQL',
	'Claude API',
	'LLaMA',
	'Whisper',
	'FLUX.1',
	'AI agents',
	'PowerShell',
	'Bash',
	'Arch Linux',
	'Windows Server',
	'Hyper-V',
	'REST APIs',
	'Git',
];

const year = new Date().getFullYear();
---

<Layout title="Italo Gules — AI Automation Specialist" nav>
	<main>
		<Hero />
		<Ticker items={tickerItems} />
		<About />
		<Skills />
		<Experience />
		<Contact qrDataUrl={qrDataUrl} />

		<footer class="border-t border-line px-5 py-10 md:px-8">
			<div class="mx-auto max-w-6xl">
				<div class="hr-dashed mb-8"></div>
				<div class="flex flex-col gap-6 text-[0.6875rem] text-line-2 sm:flex-row sm:items-center sm:justify-between">
					<p>&copy; {year} Italo Gules — all processes automated where possible.</p>
					<div class="flex flex-wrap items-center gap-4">
						<a href="/card" class="link">contact card</a>
						<a
							href="https://www.linkedin.com/in/italogules/"
							target="_blank"
							rel="noopener"
							class="link">linkedin</a
						>
						<a href="/speedometer.html" class="link">speedometer</a>
						<span class="hidden text-line sm:inline">|</span>
						<span>astro · tailwind · arch btw</span>
					</div>
				</div>
			</div>
		</footer>

		<!-- floating speedometer easter egg -->
		<a
			href="/speedometer.html"
			class="group fixed bottom-5 right-5 z-40 flex items-center gap-2.5 border border-line-2 bg-ink/90 px-3.5 py-2.5 text-[0.6875rem] text-dim backdrop-blur-md transition-all duration-300 hover:border-lime/50 hover:text-lime"
			aria-label="Open the speedometer"
		>
			<span class="dot-live"></span>
			<svg
				class="h-3.5 w-3.5 text-lime transition-transform duration-500 group-hover:rotate-[18deg]"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="m12 14 4-4" />
				<path d="M3.34 19a10 10 0 1 1 17.32 0" />
			</svg>
			<span class="hidden sm:inline">speedometer</span>
		</a>
	</main>
</Layout>
