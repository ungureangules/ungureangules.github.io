---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import Ticker from '../components/Ticker.astro';
import QRCode from 'qrcode';

const qrDataUrl = await QRCode.toDataURL('https://italogules.dev/card', {
	width: 280,
	margin: 1,
	color: { dark: '#56b6e8', light: '#07080a' },
});

const tickerItems = [
	'Python',
	'Java',
	'React',
	'SQL',
	'Claude API',
	'LLaMA',
	'Whisper',
	'FLUX.1',
	'AI agents',
	'PowerShell',
	'Bash',
	'Arch Linux',
	'Windows Server',
	'Hyper-V',
	'REST APIs',
	'Git',
];

const year = new Date().getFullYear();
---

<Layout title="Italo Gules — AI Automation Specialist" nav>
	<main>
		<Hero />
		<Ticker items={tickerItems} />
		<About />
		<Skills />
		<Experience />
		<Projects />
		<Contact qrDataUrl={qrDataUrl} />

		<footer class="border-t border-line px-5 py-10 md:px-8">
			<div class="mx-auto max-w-6xl">
				<div class="hr-dashed mb-8"></div>
				<div class="flex flex-col gap-6 text-[0.6875rem] text-line-2 sm:flex-row sm:items-center sm:justify-between">
					<p>&copy; {year} Italo Gules — all processes automated where possible.</p>
					<div class="flex flex-wrap items-center gap-4">
						<a href="/card" class="link">contact card</a>
						<a
							href="https://www.linkedin.com/in/italogules/"
							target="_blank"
							rel="noopener"
							class="link">linkedin</a
						>
						<span class="hidden text-line sm:inline">|</span>
						<span>astro · tailwind · arch btw</span>
					</div>
				</div>
			</div>
		</footer>

	</main>
</Layout>
