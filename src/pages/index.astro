---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
---

<Layout title="Italo Gules | Serial Fixer & AI Automation Specialist">
	<main>
		<Hero />
		<About />
		<Skills />
		<Experience />
		
		<footer id="contact" class="py-12 border-t border-zinc-900">
			<div class="container mx-auto px-6 text-center">
				<h2 class="text-2xl font-bold text-white mb-6">Let's build the future together</h2>
				<p class="text-zinc-400 mb-8 max-w-md mx-auto">
					I'm always looking for interesting problems to solve and processes to automate.
				</p>
				<div class="flex justify-center gap-6">
					<a href="https://www.linkedin.com/in/italogules/" target="_blank" class="text-zinc-400 hover:text-orange-500 transition-colors">LinkedIn</a>
					<a href="https://github.com/ungureangules" target="_blank" class="text-zinc-400 hover:text-orange-500 transition-colors">GitHub</a>
					<a href="mailto:italogules@gmail.com" class="text-zinc-400 hover:text-orange-500 transition-colors">Email</a>
				</div>
				<div class="mt-12 text-zinc-600 text-sm font-mono">
					&copy; {new Date().getFullYear()} Italo Gules. Built with Astro & Tailwind.
				</div>
			</div>
		</footer>
	</main>
</Layout>
