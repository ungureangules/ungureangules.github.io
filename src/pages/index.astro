---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import QRCode from 'qrcode';

const qrDataUrl = await QRCode.toDataURL('https://italogules.dev/card', {
	width: 120,
	margin: 2,
	color: { dark: '#1793d1', light: '#09090b' }
});
---

<Layout title="Italo Gules | Serial Fixer & AI Automation Specialist">
	<main>
		<Hero />
		<About />
		<Skills />
		<Experience />
		
		<footer id="contact" class="py-12 border-t border-zinc-900">
			<div class="container mx-auto px-6 text-center">
				<h2 class="text-2xl font-bold text-white mb-6">Let's build the future together</h2>
				<p class="text-zinc-400 mb-8 max-w-md mx-auto">
					I'm always looking for interesting problems to solve and processes to automate.
				</p>
				<div class="flex flex-col items-center gap-6">
					<a href="/card" class="group flex flex-col items-center gap-2">
						<div class="rounded-xl overflow-hidden border border-zinc-800 group-hover:border-[#1793d1]/50 p-2 bg-zinc-950 transition-colors">
							<img src={qrDataUrl} alt="Scan to open contact card" class="w-24 h-24" />
						</div>
						<span class="text-xs text-zinc-500 group-hover:text-[#1793d1] transition-colors font-mono uppercase tracking-widest">Scan or tap for contact card</span>
					</a>
					<div class="flex justify-center gap-6">
						<a href="https://www.linkedin.com/in/italogules/" target="_blank" class="text-zinc-400 hover:text-[#1793d1] transition-colors">LinkedIn</a>
						<a href="mailto:italogules@gmail.com" class="text-zinc-400 hover:text-[#1793d1] transition-colors">Email</a>
					</div>
				</div>
				<div class="mt-12 text-zinc-600 text-sm font-mono">
					&copy; {new Date().getFullYear()} Italo Gules. Built with Astro & Tailwind.
				</div>
			</div>
		</footer>
	</main>
</Layout>
